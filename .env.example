# Public client config only — safe to ship in the app binary.
# Real secrets (service_role, push hook, etc.) live in Supabase Edge / Dashboard — never here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key is publishable; Row Level Security is the lock. Do NOT use service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional. WhatsApp digits with country code, no plus. Example: 972594295100
EXPO_PUBLIC_SUPPORT_WHATSAPP=972594295100
# Optional. Apple App Store numeric id, used for Rate on iOS.
EXPO_PUBLIC_IOS_APP_STORE_ID=
# Keep React Native fetch as the global. Avoids ExpoFetchModule on Expo Go boot.
EXPO_PUBLIC_USE_RN_FETCH=1

{
  "expo": {
    "name": "Matraح",
    "slug": "sakanat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "sakanat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ps.sakanat.app",
      "infoPlist": {
        "CFBundleName": "Matraح",
        "CFBundleDisplayName": "مطرح"
      }
    },
    "android": {
      "package": "ps.sakanat.app",
      "label": "مطرح",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#EEF1EF",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#EEF1EF"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1B4A3C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج إلى الصور حتى يضيف المالك صور الشقة وترسل صور في المحادثة.",
          "cameraPermission": "نحتاج إلى الكاميرا لالتقاط صورة وإرسالها في المحادثة."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location so you can pick your home address on the map."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "نحتاج إلى الميكروفون لإرسال رسائل صوتية في المحادثة.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
